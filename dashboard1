        // (Gemini: Analisar Chat WhatsApp)
        async function analisarChatGemini(button, chatId) {
            const chat = mockNovosChats.find(c => c.id === chatId);
            if (!chat) return;

            const outputDiv = document.getElementById(`ia-response-${chat.id}`);
            const spinner = `<div class="flex items-center space-x-2"><div class="spinner"></div><span class="text-xs text-gray-400">Analisando...</span></div>`;
            outputDiv.innerHTML = spinner;
            outputDiv.classList.remove('hidden');
            button.disabled = true;

            const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${GEMINI_API_KEY}`;
            
            const prompt = `Analise a seguinte mensagem de WhatsApp para uma loja de motos. Classifique-a em uma das três categorias: 'cliente' (problema na moto, revisão), 'empresa' (compra B2B, CNPJ), ou 'vendas' (compra de acessório, capacete, pneu). Forneça um resumo muito curto da solicitação. A mensagem é: "${chat.msg}"`;

            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            "categoria": { "type": "STRING", "enum": ["cliente", "empresa", "vendas"] },
                            "resumo": { "type": "STRING" }
                        },
                        required: ["categoria", "resumo"]
                    }
                }
            };

            try {
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                
                const result = await response.json();
                const jsonText = result.candidates[0].content.parts[0].text;
                const data = JSON.parse(jsonText);

                outputDiv.innerHTML = `<p class="text-sm text-gray-300"><span class="font-medium text-orange-400">Sugestão:</span> ${data.resumo} <span class="text-xs text-gray-500">(${data.categoria})</span></p>`;
            
            } catch (error) {
                console.error("Erro na API Gemini (Analisar Chat):", error);
                outputDiv.innerHTML = `<p class="text-xs text-red-400">Não foi possível analisar o chat.</p>`;
            } finally {
                button.disabled = false;
            }
        }

