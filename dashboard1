    const topItems = stock
      .filter(i => i.sales > 5 && i.qty < i.min * 2)
      .map(i => ({ id: Date.now() + Math.random(), item: i.name, qty: 5, value: i.price, location: i.location }));
    
    const patioItems = waitingPartsOrders.map(o => ({
        id: Date.now() + Math.random(),
        item: o.missingParts,
        qty: 1,
        value: 0, 
        location: 'PÁTIO',
        linkedOrderId: o.id 
    }));

    const newItems = [...topItems, ...patioItems];
    
    if (newItems.length > 0) {
      setCart([...cart, ...newItems]);
      setCartModal(true);
    } else {
      alert("Nenhum item precisa de reposição urgente, e não há pendências de pátio.");
    }
  };

  const attemptCheckout = () => {
    if (cart.length === 0) return;
    const missingInCart = requiredParts.filter(reqPart => 
        !cart.some(cartItem => cartItem.item.toLowerCase().includes(reqPart.toLowerCase()))
    );

    if (missingInCart.length > 0) {
        setConfirmationModal({ show: true, missingParts: missingInCart });
