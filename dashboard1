           <div className="space-y-6">
              <div>
                <div className="flex justify-between mb-2"><span className="text-sm font-bold text-gray-700">Cortar Custos Fixos (Pessoal/Adm)</span><span className="text-sm font-bold text-red-500">-{fixedCut}%</span></div>
