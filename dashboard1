// Funções auxiliares movidas para o topo e definidas como 'function' para garantir hoisting
function formatCurrency(val) { return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(val); }
function generateMonthData(monthName) { return BASE_EMPLOYEES.map(emp => ({ ...emp, costHelps: [], discounts: [], isPaid15: false, isPaid01: false, receipt15: null, receipt01: null })); }
function formatCPF(v) { return v.replace(/\D/g,'').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d)/,'$1.$2').replace(/(\d{3})(\d{1,2})/,'$1-$2').replace(/(-\d{2})\d+?$/,'$1'); }
function formatDuration(ms) {
  if (!ms) return '0min';
  const mins = Math.floor(ms / 60000);
  const hours = Math.floor(mins / 60);
  return hours > 0 ? `${hours}h ${mins % 60}m` : `${mins}m`;
}

