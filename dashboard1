  const [selectedOrder, setSelectedOrder] = useState(null); 
  const [draggedOrder, setDraggedOrder] = useState(null);

  // --- Colunas Atualizadas ---
  const columns = [
    { id: 'pending', title: 'Pendente', color: 'bg-gray-500', text: 'text-gray-600', bg: 'bg-gray-100', icon: Clock },
    { id: 'waiting_parts', title: 'Aguardando Peça', color: 'bg-orange-500', text: 'text-orange-600', bg: 'bg-orange-50/50', icon: AlertTriangle },
    { id: 'execution', title: 'Em Execução', color: 'bg-blue-500', text: 'text-blue-600', bg: 'bg-blue-50/50', icon: Wrench },
    { id: 'finished', title: 'Finalizado', color: 'bg-emerald-500', text: 'text-emerald-600', bg: 'bg-emerald-50/50', icon: CheckSquare },
    { id: 'delivered', title: 'Entregue', color: 'bg-purple-500', text: 'text-purple-600', bg: 'bg-purple-50/50', icon: UserPlus },
  ];

  const handleAddOS = () => {
    if(!newOS.bike || !newOS.plate) return;
    const newOrder = {
      id: `OS-${2028 + orders.length}`,
      ...newOS,
      status: 'pending',
      entry: new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}),
      history: [{ stage: 'pending', time: Date.now() }],
      partsStatus: 'none'
    };
    updateOrder(newOrder, true); // True for add
    setShowModal(false);
    setNewOS({ bike: '', plate: '', client: '', mechanic: '', service: '', km: '', fuelType: 'Gasolina', obs: '' });
  };

  const onDragStart = (e, id) => {
    setDraggedOrder(id);
    e.dataTransfer.effectAllowed = "move";
  };

  const onDragOver = (e) => { e.preventDefault(); };

  const onDrop = (e, newStatus) => {
    e.preventDefault();
    if (draggedOrder) {
      const order = orders.find(o => o.id === draggedOrder);
      if (newStatus === 'delivered') {
        setDeliveryModal({ show: true, order: order, kmFinal: '', payment: 'pix', whatsappSent: false });
      } else {
        // If moving OUT of waiting_parts, calculate wait time
        let updatedOrder = { ...order, status: newStatus };
        
        // Update History
        updatedOrder.history = [...(order.history || []), { stage: newStatus, time: Date.now() }];
        
        updateOrder(updatedOrder);
      }
      setDraggedOrder(null);
    }
  };

  const confirmDelivery = () => {
    if (!deliveryModal.whatsappSent) return alert("É obrigatório enviar a mensagem para o cliente antes de confirmar!");
    if (!deliveryModal.kmFinal) return alert("Informe a quilometragem final!");
    
    const updatedOrder = { 
        ...deliveryModal.order, 
        status: 'delivered', 
        kmFinal: deliveryModal.kmFinal, 
        paymentType: deliveryModal.payment,
        history: [...(deliveryModal.order.history || []), { stage: 'delivered', time: Date.now() }]
