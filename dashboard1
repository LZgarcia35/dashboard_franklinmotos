<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Franklin Motos - Gestão</title>
    <!-- Carrega o Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Carrega o Google Fonts "Inter" -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Carrega a biblioteca Chart.js para os gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #111827; /* bg-gray-900 */
            color: #f3f4f6; /* bg-gray-100 */
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        /* Estilo de scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #374151; /* bg-gray-700 */
        }
        ::-webkit-scrollbar-thumb {
            background: #6b7280; /* bg-gray-500 */
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af; /* bg-gray-400 */
        }
        /* Ajuste para o gráfico manter a proporção */
        .chart-container {
            position: relative;
            height: 250px;
            width: 100%;
        }
        /* Esconde a view por padrão */
        .view-content {
            display: none;
        }
        /* Mostra a view ativa */
        .view-content.active {
            display: block;
        }
        /* Estilo da Aba de Navegação Ativa */
        .nav-link.active {
            border-bottom-color: #f97316; /* orange-500 */
            color: #f97316; /* orange-500 */
        }
        /* Animação de Loading */
        .spinner {
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-left-color: #f97316;
            border-radius: 50%;
            width: 14px;
            height: 14px;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="antialiased">

    <!-- Tela de Login (Mesma do app Franklin Motos) -->
    <div id="login-screen" class="fixed inset-0 bg-gray-950 flex items-center justify-center p-4 z-50">
        <div class="bg-gray-900 rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center border border-gray-800">
            <div class="flex flex-col items-center justify-center mb-6">
                 <!-- Ícone de Scooter (SVG) -->
                 <svg class="w-16 h-16 text-orange-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                </svg>
                <h1 class="text-3xl font-bold text-gray-50 mb-1">Franklin Motos</h1>
                <p class="text-gray-400 text-sm">Dashboard de Gerenciamento</p>
            </div>
            <form id="login-form">
                <div class="mb-4">
                    <input type="text" id="username" placeholder="Usuário" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-orange-500" autocomplete="off">
                </div>
                <div class="mb-6">
                    <input type="password" id="password" placeholder="Senha" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
                <button type="submit" class="w-full bg-orange-500 text-white font-semibold rounded-lg py-3.5 text-lg transition duration-200 hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-opacity-50">
                    Entrar
                </button>
            </form>
            <p id="login-error-message" class="text-red-400 text-sm mt-4 hidden">Usuário ou senha incorretos.</p>
        </div>
    </div>

    <!-- Container Principal do Dashboard (inicialmente oculto) -->
    <div id="app" class="flex flex-col min-h-screen hidden">

        <!-- 1. Barra de Navegação Superior (Header) -->
        <header class="bg-gray-800 border-b border-gray-700 shadow-sm sticky top-0 z-10">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center h-16">
                    <!-- Lado Esquerdo: Logo e Título -->
                    <div class="flex items-center space-x-4">
                        <svg class="w-8 h-8 text-orange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                           <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                       </svg>
                        <span class="text-2xl font-bold text-white">Franklin Motos</span>
                        <span id="header-title" class="text-lg text-gray-300 font-medium hidden sm:block">Gestão</span>
                    </div>
                    <!-- Lado Direito: Ícones -->
                    <div class="flex items-center space-x-5">
                        <button class="text-gray-400 hover:text-orange-500 relative">
                            <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                            </svg>
                            <span id="notification-badge" class="absolute -top-1 -right-1 w-4 h-4 bg-red-600 text-white text-xs font-bold rounded-full flex items-center justify-center">0</span>
                        </button>
                        <button id="logout-button" onclick="logout()" title="Sair da conta" class="text-gray-400 hover:text-orange-500 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- 2. Barra de Sub-Navegação (Abas de Função) -->
        <nav id="nav-bar" class="bg-gray-800 border-b border-gray-700">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto">
                <div class="flex space-x-6">
                    <!-- As abas serão preenchidas pelo JS, exemplo: -->
                    <a href="#" id="nav-atendimento" class="nav-link flex items-center space-x-2 px-1 py-4 border-b-2 border-transparent text-sm font-medium text-gray-400 hover:border-gray-500 hover:text-gray-300 whitespace-nowrap" data-view="atendimento" onclick="showView('atendimento')">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Atendimento</span>
                    </a>
                    <a href="#" id="nav-oficina" class="nav-link flex items-center space-x-2 px-1 py-4 border-b-2 border-transparent text-sm font-medium text-gray-400 hover:border-gray-500 hover:text-gray-300 whitespace-nowrap" data-view="oficina" onclick="showView('oficina')">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.83-5.83M11.42 15.17l-4.25-4.25a2.652 2.652 0 010-3.75l4.25-4.25a2.652 2.652 0 013.75 0l4.25 4.25a2.652 2.652 0 010 3.75l-4.25 4.25z" /></svg>
                        <span>Solicitar O.S.</span>
                    </a>
                    <a href="#" id="nav-admin" class="nav-link flex items-center space-x-2 px-1 py-4 border-b-2 border-transparent text-sm font-medium text-gray-400 hover:border-gray-500 hover:text-gray-300 whitespace-nowrap" data-view="admin" onclick="showView('admin')">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0M3.75 18H7.5m3-6h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0M3.75 12H7.5" /></svg>
                        <span id="nav-admin-text">Gerenciar</span>
                    </a>
                    <a href="#" id="nav-estoque" class="nav-link flex items-center space-x-2 px-1 py-4 border-b-2 border-transparent text-sm font-medium text-gray-400 hover:border-gray-500 hover:text-gray-300 whitespace-nowrap" data-view="estoque" onclick="showView('estoque')">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M7.5 7.5V4.875c0-.621.504-1.125 1.125-1.125h6.75c.621 0 1.125.504 1.125 1.125V7.5m-6.75 0h6.75" /></svg>
                        <span>Estoque</span>
                    </a>
                    <a href="#" id="nav-historico" class="nav-link flex items-center space-x-2 px-1 py-4 border-b-2 border-transparent text-sm font-medium text-gray-400 hover:border-gray-500 hover:text-gray-300 whitespace-nowrap" data-view="historico" onclick="showView('historico')">
                         <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>Histórico</span>
                    </a>
                </div>
            </div>
        </nav>

        <!-- 3. Conteúdo Principal da Página (Views) -->
        <main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">

            <!-- KPIs (Stats Cards) - Agora dinâmicos -->
            <section class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <!-- Novos Chats -->
                <div class="bg-gray-800 p-4 rounded-lg shadow-sm border border-gray-700">
                    <p class="text-sm text-gray-400">Novos Chats (WhatsApp)</p>
                    <p id="kpi-novos-chats" class="text-2xl font-semibold text-orange-500">0</p>
                </div>
                <!-- Pedidos Pendentes -->
                <div class="bg-gray-800 p-4 rounded-lg shadow-sm border border-gray-700">
                    <p class="text-sm text-gray-400">Pedidos Pendentes (Estoque)</p>
                    <p id="kpi-pedidos-pendentes" class="text-2xl font-semibold text-yellow-400">0</p>
                </div>
                <!-- O.S. Abertas -->
                <div class="bg-gray-800 p-4 rounded-lg shadow-sm border border-gray-700">
                    <p class="text-sm text-gray-400">O.S. Abertas</p>
                    <p id="kpi-os-abertas" class="text-2xl font-semibold text-blue-400">0</p>
                </div>
                <!-- Entregas do Dia -->
                <div class="bg-gray-800 p-4 rounded-lg shadow-sm border border-gray-700">
                    <p class="text-sm text-gray-400">Entregas de Hoje</p>
                    <p id="kpi-entregas-dia" class="text-2xl font-semibold text-green-500">0</p>
                </div>
            </section>

            <!-- Gráficos (Mantidos do layout Ultracar) -->
            <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                <!-- Gráfico 1: Peças e Serviços -->
                <div class="bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-700">
                    <h3 class="text-lg font-medium text-gray-100 mb-4">Relatório de Peças e Serviços</h3>
                    <div class="chart-container">
                        <canvas id="chartPecasServicos"></canvas>
                    </div>
                </div>
                <!-- Gráfico 2: Financeiro -->
                <div class="bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-700">
                    <h3 class="text-lg font-medium text-gray-100 mb-4">Relatório Financeiro</h3>
                    <div class="chart-container">
                        <canvas id="chartFinanceiro"></canvas>
                    </div>
                </div>
                <!-- Gráfico 3: Ticket Médio -->
                <div class="bg-gray-800 p-6 rounded-lg shadow-sm border border-gray-700">
                    <h3 class="text-lg font-medium text-gray-100 mb-4">Relatório de Ticket Médio</h3>
                    <div class="chart-container">
                        <canvas id="chartTicketMedio"></canvas>
                    </div>
                </div>
            </section>

            <!-- Conteúdo das Abas do App -->
            <section id="views-container">

                <!-- ABA 1: Atendimento (Conteúdo migrado) -->
                <div id="view-atendimento" class="view-content active grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 space-y-6">
                        <!-- Novos Chats -->
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <h3 class="text-lg font-semibold text-gray-100 mb-3">Novos Chats</h3>
                            <div id="novos-chats-lista" class="space-y-3 max-h-[300px] overflow-y-auto pr-2"></div>
                        </div>
                        <!-- Pedido de Balcão -->
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <h3 class="text-lg font-semibold text-gray-100 mb-3">Pedido de Balcão (Venda Rápida)</h3>
                            <div class="relative mb-4">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg></span>
                                <input type="search" id="search-peca-balcao" placeholder="Buscar peça por nome ou código..." class="w-full bg-gray-900 border border-gray-700 rounded-full py-2.5 pl-10 pr-4 text-gray-50 focus:outline-none focus:ring-2 focus:ring-orange-500">
                            </div>
                            <div id="lista-pecas-balcao" class="space-y-2 mb-4 max-h-48 overflow-y-auto pr-2">
                                <p class="text-sm text-gray-500 text-center">Use a busca para ver as peças.</p>
                            </div>
                            <div id="carrinho-balcao-container" class="hidden">
                                <h4 class="text-md font-medium text-gray-200 mb-2">Itens do Pedido</h4>
                                <div id="carrinho-balcao" class="space-y-2 mb-4 min-h-[40px]"></div>
                                <button onclick="enviarPedidoBalcao()" class="w-full bg-orange-500 text-white font-medium rounded-lg py-3 text-center transition duration-200 hover:bg-orange-600 shadow-md shadow-orange-500/30">
                                    Enviar Pedido ao Estoque
                                </button>
                            </div>
                        </div>
                    </div>
                    <!-- Filas de Atendimento -->
                    <div class="lg:col-span-1 space-y-4">
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <div class="flex items-center space-x-2 mb-2">
                                <span class="w-3 h-3 bg-orange-500 rounded-full"></span>
                                <span class="font-medium text-gray-100">Atendimento Cliente</span>
                                <span id="count-cliente" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                            </div>
                            <div id="fila-cliente" class="pl-5 space-y-2"><p class="text-sm text-gray-500">Nenhum chat na fila.</p></div>
                        </div>
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <div class="flex items-center space-x-2 mb-2">
                                <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                                <span class="font-medium text-gray-100">Atendimento Empresas</span>
                                <span id="count-empresa" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                            </div>
                            <div id="fila-empresa" class="pl-5 space-y-2"><p class="text-sm text-gray-500">Nenhum chat na fila.</p></div>
                        </div>
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <div class="flex items-center space-x-2 mb-2">
                                <span class="w-3 h-3 bg-purple-500 rounded-full"></span>
                                <span class="font-medium text-gray-100">Vendas Online</span>
                                <span id="count-vendas" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                            </div>
                            <div id="fila-vendas" class="pl-5 space-y-2"><p class="text-sm text-gray-500">Nenhum chat na fila.</p></div>
                        </div>
                    </div>
                </div>

                <!-- ABA 2: Solicitar O.S. (Oficina) (Conteúdo migrado) -->
                <div id="view-oficina" class="view-content grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2">
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <h2 class="text-2xl font-semibold text-gray-100 mb-4">Solicitação de Peças (O.S.)</h2>
                            <div class="relative mb-4">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg></span>
                                <input type="search" id="search-peca-os" placeholder="Buscar peça por nome ou código..." class="w-full bg-gray-900 border border-gray-700 rounded-full py-2.5 pl-10 pr-4 text-gray-50 focus:outline-none focus:ring-2 focus:ring-orange-500">
                            </div>
                            <div id="lista-pecas-os" class="space-y-2 mb-6 max-h-[500px] overflow-y-auto pr-2">
                                <p class="text-sm text-gray-500 text-center">Use a busca para ver as peças.</p>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-1">
                        <div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                            <h3 class="text-lg font-semibold text-gray-100 mb-3">Itens da O.S.</h3>
                            <div id="carrinho-mecanico" class="space-y-2 mb-4 min-h-[150px] max-h-[300px] overflow-y-auto pr-2">
                                <p class="text-sm text-gray-500" id="carrinho-vazio-msg-os">Nenhuma peça selecionada.</p>
                            </div>
                            <div class="mb-4">
                                <label for="anexo-os-input" class="w-full text-center bg-gray-700 text-gray-300 font-medium rounded-lg py-2.5 px-4 transition duration-200 hover:bg-gray-600 cursor-pointer flex items-center justify-center space-x-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" /></svg>
                                    <span>Anexar O.S. (Img/PDF)</span>
                                </label>
                                <input type="file" id="anexo-os-input" class="hidden" accept="image/*,.pdf" onchange="handleAnexoOS(event)">
                                <p id="anexo-os-filename" class="text-xs text-gray-400 text-center mt-2"></p>
                            </div>
                            <button onclick="enviarPedidoOficinaOS()" class="w-full bg-orange-500 text-white font-medium rounded-lg py-3 text-center transition duration-200 hover:bg-orange-600 shadow-md shadow-orange-500/30">
                                Enviar Solicitação ao Estoque
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ABA 3: Gerenciar O.S. / Painel Admin (Conteúdo migrado) -->
                <div id="view-admin" class="view-content grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Painel: Novas Solicitações da Oficina -->
                    <div id="admin-panel-solicitacoes" class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                        <h3 class="text-lg font-semibold text-gray-100 mb-3">Solicitações Pendentes (Visão Admin)</h3>
