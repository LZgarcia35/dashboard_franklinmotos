<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Franklin Motos - Dashboard</title>
    <!-- Carrega o Tailwind CSS --><script src="https://cdn.tailwindcss.com"></script>
    <!-- Carrega o Google Fonts "Inter" --><link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        /* Define a fonte Inter como padrão, similar ao iOS */
        body {
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Estilo de scrollbar mais fino e sutil para tema escuro */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #2a2a2a; /* Fundo mais escuro */
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #555555; /* Thumb mais claro */
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #777777;
        }

        /* Esconde a view por padrão */
        .view-content {
            display: none;
        }
        /* Mostra a view ativa */
        .view-content.active {
            display: block;
        }

        /* Estilo do toggle (checkbox) para tema escuro */
        .toggle-checkbox {
            @apply border-gray-600;
        }
        .toggle-checkbox:checked {
            right: 0;
            border-color: #f97316; /* cor laranja-500 */
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #f97316; /* cor laranja-500 */
        }

        /* Estilo para a barra de navegação inferior (blur) */
        .nav-bar-blur {
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            background-color: rgba(29, 29, 31, 0.7); /* Mais escuro e transparente */
        }
        
        /* Ajuste para o padding inferior no container principal */
        #content-container {
            padding-bottom: 90px; /* Para acomodar a navegação inferior */
        }
        
        /* Estilo para o ícone de 'loading' (spinner) */
        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: #f97316; /* Laranja */
            border-radius: 50%;
            width: 16px;
            height: 16px;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

    </style>
</head>
<body class="bg-gray-900 text-gray-100">

    <!-- Tela de Login --><div id="login-screen" class="fixed inset-0 bg-gray-950 flex items-center justify-center p-4 z-50">
        <div class="bg-gray-900 rounded-2xl shadow-2xl p-8 w-full max-w-sm text-center border border-gray-800">
            <div class="flex flex-col items-center justify-center mb-6">
                 <!-- Ícone de Scooter (SVG) --><svg class="w-16 h-16 text-orange-500 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                </svg>
                <h1 class="text-3xl font-bold text-gray-50 mb-1">Franklin Motos</h1>
                <p class="text-gray-400 text-sm">Dashboard de Gerenciamento</p>
            </div>

            <form id="login-form">
                <div class="mb-4">
                    <input type="text" id="username" placeholder="Usuário" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-orange-500" autocomplete="off">
                </div>
                <div class="mb-6">
                    <input type="password" id="password" placeholder="Senha" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-3 px-4 focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>
                <button type="submit" class="w-full bg-orange-500 text-white font-semibold rounded-lg py-3.5 text-lg transition duration-200 hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-opacity-50">
                    Entrar
                </button>
            </form>
            <p id="login-error-message" class="text-red-400 text-sm mt-4 hidden">Usuário ou senha incorretos.</p>
        </div>
    </div>

    <!-- Container principal simulando um app de celular --><div id="app" class="max-w-lg mx-auto h-screen bg-gray-900 shadow-2xl flex flex-col overflow-hidden hidden">

        <!-- Cabeçalho Fixo --><header class="bg-gray-900 border-b border-gray-800 p-4 shadow-sm">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <svg class="w-8 h-8 text-orange-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                         <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                    </svg>
                    <h1 class="text-xl font-bold text-gray-50">Franklin Motos</h1>
                </div>
                <!-- Ícones de Cabeçalho (Notificação e Sair) -->
                <div class="flex items-center space-x-4">
                    <!-- Ícone de Notificação -->
                    <div class="relative">
                        <svg class="w-6 h-6 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                        </svg>
                        <span id="notification-badge" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center hidden">
                            0
                        </span>
                    </div>
                    <!-- Botão de Sair (Logout) -->
                    <button id="logout-button" onclick="logout()" title="Sair" class="text-gray-400 hover:text-orange-500 transition-colors duration-200">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- Conteúdo principal (troca de abas) --><main id="content-container" class="flex-grow p-4 overflow-y-auto">
            
            <!-- ABA 1: Atendimento WhatsApp --><div id="view-atendimento" class="view-content active">
                <h2 class="text-2xl font-semibold text-gray-50 mb-4">Atendimento WhatsApp</h2>
                
                <!-- Novos Chats (Simulação) --><div class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Novos Chats</h3>
                    <div id="novos-chats-lista">
                        <!-- Chats serão injetados aqui pelo JS --></div>
                </div>

                <!-- Filas de Atendimento --><div>
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Filas</h3>
                    <!-- Fila 1: Cliente --><div class="mb-4 bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                        <div class="flex items-center space-x-2 mb-2">
                            <span class="w-3 h-3 bg-orange-500 rounded-full"></span>
                            <span class="font-medium text-gray-50">Atendimento Cliente</span>
                            <span id="count-cliente" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                        </div>
                        <div id="fila-cliente" class="pl-5 space-y-2">
                            <!-- Clientes atribuídos aqui --><p class="text-sm text-gray-500">Nenhum chat na fila.</p>
                        </div>
                    </div>
                    <!-- Fila 2: Empresas --><div class="mb-4 bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                        <div class="flex items-center space-x-2 mb-2">
                            <span class="w-3 h-3 bg-green-500 rounded-full"></span>
                            <span class="font-medium text-gray-50">Atendimento Empresas</span>
                            <span id="count-empresa" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                        </div>
                        <div id="fila-empresa" class="pl-5 space-y-2">
                            <p class="text-sm text-gray-500">Nenhum chat na fila.</p>
                        </div>
                    </div>
                    <!-- Fila 3: Vendas Online --><div class="mb-4 bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                        <div class="flex items-center space-x-2 mb-2">
                            <span class="w-3 h-3 bg-purple-500 rounded-full"></span>
                            <span class="font-medium text-gray-50">Vendas Online (Acessórios)</span>
                            <span id="count-vendas" class="text-sm text-gray-400 bg-gray-700 rounded-full px-2 py-0.5">0</span>
                        </div>
                        <div id="fila-vendas" class="pl-5 space-y-2">
                            <p class="text-sm text-gray-500">Nenhum chat na fila.</p>
                        </div>
                    </div>
                </div>

                <!-- NOVO: Pedido de Balcão (para Atendentes) -->
                <div id="atendimento-balcao-panel" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Pedido de Balcão (Venda Rápida)</h3>
                     <!-- Barra de Pesquisa de Peças --><div class="relative mb-4">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                            </svg>
                        </span>
                        <input type="search" id="search-peca-balcao" placeholder="Buscar peça por nome ou código..." class="w-full bg-gray-700 border border-gray-600 rounded-full py-2.5 pl-10 pr-4 text-gray-50 focus:outline-none focus:ring-2 focus:ring-orange-500">
                    </div>
                    
                    <!-- Lista de Peças (do "Estoque") -->
                    <div id="lista-pecas-balcao" class="space-y-2 mb-4 max-h-40 overflow-y-auto pr-2">
                        <p class="text-sm text-gray-500 text-center">Busque uma peça...</p>
                    </div>

                    <!-- Carrinho de Solicitação -->
                    <div>
                        <h4 class="text-md font-semibold text-gray-50 mb-3">Itens do Pedido</h4>
                        <div id="carrinho-atendente-balcao" class="space-y-2 mb-4 min-h-[40px]">
                            <p class="text-sm text-gray-500" id="carrinho-balcao-vazio-msg">Nenhum item adicionado.</p>
                            <!-- Peças adicionadas ao carrinho aqui -->
                        </div>
                        <button onclick="enviarPedidoBalcao()" class="w-full bg-orange-500 text-white font-medium rounded-lg py-3 text-center transition duration-200 hover:bg-orange-600 shadow-md shadow-orange-500/30">
                            <span class="flex items-center justify-center">
                                <span id="balcao-submit-text">Enviar Pedido ao Estoque</span>
                                <span id="balcao-submit-spinner" class="spinner hidden ml-2"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- ABA 2: Solicitação de O.S. (para Atendentes) / Pedidos (para Admin) --><div id="view-oficina" class="view-content">
                <h2 class="text-2xl font-semibold text-gray-50 mb-4">Solicitação da Oficina (O.S.)</h2>
                
                <!-- Barra de Pesquisa de Peças --><div class="relative mb-4">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                        </svg>
                    </span>
                    <input type="search" id="search-peca-os" placeholder="Buscar peça por nome ou código..." class="w-full bg-gray-800 border border-gray-700 rounded-full py-2.5 pl-10 pr-4 text-gray-50 focus:outline-none focus:ring-2 focus:ring-orange-500">
                </div>

                <!-- Lista de Peças (do "Estoque") --><div id="lista-pecas-os" class="space-y-2 mb-6 h-64 overflow-y-auto pr-2">
                    <!-- Peças do mockEstoque serão injetadas aqui --></div>

                <!-- Carrinho de Solicitação --><div class="bg-gray-800 rounded-xl shadow-lg p-4 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Peças Solicitadas</h3>
                    <div id="carrinho-atendente-os" class="space-y-2 mb-4 min-h-[40px]">
                        <p class="text-sm text-gray-500" id="carrinho-os-vazio-msg">Nenhuma peça selecionada.</p>
                        <!-- Peças adicionadas ao carrinho aqui --></div>
                    
                    <!-- Anexar O.S. -->
                    <div class="mb-4">
                        <label for="os-file-input" class="w-full bg-gray-700 text-gray-300 font-medium rounded-lg py-3 text-center transition duration-200 hover:bg-gray-600 flex items-center justify-center cursor-pointer">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 mr-2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                            </svg>
                            Anexar O.S. (Img/PDF)
                        </label>
                        <input type="file" id="os-file-input" class="hidden" accept="image/*,application/pdf">
                        <p id="os-file-feedback" class="text-xs text-gray-400 mt-2 text-center truncate"></p>
                    </div>

                    <button onclick="enviarPedidoOS()" class="w-full bg-orange-500 text-white font-medium rounded-lg py-3 text-center transition duration-200 hover:bg-orange-600 shadow-md shadow-orange-500/30">
                        <span class="flex items-center justify-center">
                            <span id="os-submit-text">Enviar Solicitação ao Estoque</span>
                            <span id="os-submit-spinner" class="spinner hidden ml-2"></span>
                        </span>
                    </button>
                </div>
            </div>

            <!-- ABA 3: Admin / Minhas O.S. (Mecânico) --><div id="view-admin" class="view-content">
                <h2 id="admin-title" class="text-2xl font-semibold text-gray-50 mb-4">Painel de Controle</h2>

                <!-- Novas Solicitações da Oficina (Visível p/ Admin) --><div id="admin-panel-solicitacoes" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Monitor de Pedidos</h3>
                    <div id="lista-solicitacoes-admin" class="space-y-3">
                        <p class="text-sm text-gray-500" id="admin-sem-pedidos">Nenhum pedido pendente.</p>
                        <!-- Pedidos da oficina aparecerão aqui --></div>
                </div>

                <!-- Ordens de Serviço (Agendamentos) (Visível p/ Admin e Mecânico) --><div id="admin-panel-agendamentos" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 id="agendamentos-title" class="text-lg font-semibold text-gray-50 mb-3">Ordens de Serviço (Máx: 4)</h3>
                    <div id="lista-agendamentos" class="space-y-3 mb-4">
                        <!-- Agendamentos serão injetados aqui -->
                    </div>
                    
                    <!-- Formulário de Novo Agendamento (oculto por padrão) -->
                    <div id="agendamento-form-container" class="hidden bg-gray-900 p-4 rounded-lg border border-gray-700 mt-4">
                        <h4 class="font-medium text-gray-100 mb-3">Nova Ordem de Serviço</h4>
                        <form id="agendamento-form">
                            <div class="space-y-3">
                                <input type="text" id="cliente-nome" placeholder="Nome do Cliente" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-orange-500" required>
                                <input type="text" id="cliente-moto" placeholder="Moto (ex: CG 160)" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-orange-500" required>
                                <input type="text" id="cliente-servico" placeholder="Serviço (ex: Revisão)" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-orange-500" required>
                                <select id="cliente-mecanico" class="w-full bg-gray-800 text-gray-50 border border-gray-700 rounded-lg py-2 px-3 focus:outline-none focus:ring-2 focus:ring-orange-500" required>
                                    <option value="">-- Selecionar Mecânico --</option>
                                    <!-- Nomes dos mecânicos aqui -->
                                </select>
                                <!-- Anexo O.S. pelo Admin -->
                                <div class="pt-1">
                                    <label for="os-file-input-admin" class="w-full bg-gray-700 text-gray-300 text-sm font-medium rounded-lg py-2 text-center transition duration-200 hover:bg-gray-600 flex items-center justify-center cursor-pointer">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 mr-2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.122 2.122l7.81-7.81a.75.75 0 011.06.001l.001.001a.75.75 0 010 1.06l-7.81 7.81m-2.124-2.122l2.124-2.124" />
                                        </svg>
                                        Anexar O.S. (Opcional)
                                    </label>
                                    <input type="file" id="os-file-input-admin" class="hidden" accept="image/*,application/pdf">
                                    <p id="os-file-feedback-admin" class="text-xs text-gray-400 mt-2 text-center truncate"></p>
                                </div>
                            </div>
                            <div class="flex space-x-2 mt-4">
                                <button type="submit" id="save-agendamento-btn" class="flex-1 bg-orange-500 text-white font-medium rounded-lg py-2 text-center transition duration-200 hover:bg-orange-600">Salvar</button>
                                <button type="button" id="cancel-agendamento-btn" class="flex-1 bg-gray-600 text-white font-medium rounded-lg py-2 text-center transition duration-200 hover:bg-gray-700">Cancelar</button>
                            </div>
                        </form>
                    </div>
                    
                    <p id="agendamento-full-msg" class="text-sm text-yellow-400 text-center hidden">Máximo de 4 O.S. pendentes atingido.</p>
                    <button id="show-agendamento-form-btn" class="w-full bg-orange-500 bg-opacity-20 text-orange-400 font-medium rounded-lg py-2 text-center transition duration-200 hover:bg-opacity-30">
                        + Adicionar Ordem de Serviço
                    </button>
                </div>

                <!-- Histórico de Entregas do Dia (Visível p/ Admin) -->
                <div id="admin-panel-entregas-dia" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Entregas do Dia (Estoque)</h3>
                    <div id="lista-entregas-dia" class="space-y-2 max-h-48 overflow-y-auto pr-2">
                        <!-- Log de entregas será injetado aqui -->
                        <p class="text-sm text-gray-500" id="entregas-dia-vazio-msg">Nenhuma entrega registrada hoje.</p>
                    </div>
                </div>

                <!-- Checklist (Visível p/ Admin) --><div id="admin-panel-checklist" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Checklist Diário</h3>
                    <div class="space-y-3">
                        <div class="flex items-center">
                            <input id="check1" type="checkbox" class="h-5 w-5 text-orange-500 rounded border-gray-600 bg-gray-700 focus:ring-orange-500">
                            <label for="check1" class="ml-3 text-gray-200">Verificar fila de Vendas Online</label>
                        </div>
                        <div class="flex items-center">
                            <input id="check2" type="checkbox" class="h-5 w-5 text-orange-500 rounded border-gray-600 bg-gray-700 focus:ring-orange-500">
                            <label for="check2" class="ml-3 text-gray-200">Conferir pedidos pendentes</label>
                        </div>
                        <div class="flex items-center">
                            <input id="check3" type="checkbox" class="h-5 w-5 text-orange-500 rounded border-gray-600 bg-gray-700 focus:ring-orange-500">
                            <label for="check3" class="ml-3 text-gray-200">Atualizar status de pedidos B2B</label>
                        </div>
                    </div>
                </div>

                <!-- Histórico de Serviços (Visível p/ Admin) --><div id="admin-panel-historico" class="bg-gray-800 rounded-xl shadow-lg p-4 mb-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-gray-50 mb-3">Histórico de Serviços</h3>
                    <div id="lista-historico" class="space-y-2 max-h-48 overflow-y-auto pr-2">
                        <p class="text-sm text-gray-500" id="historico-vazio-msg">Nenhum serviço concluído.</p>
