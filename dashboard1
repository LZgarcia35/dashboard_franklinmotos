// --- SIMULADOR FINANCEIRO (NOVO) ---
const FinancialSimulator = ({ onClose, currentData }) => {
  const [fixedCut, setFixedCut] = useState(0);
  const [salesIncrease, setSalesIncrease] = useState(0);
  const [variableCut, setVariableCut] = useState(0);

  const projectedFixed = currentData.fixed * (1 - fixedCut / 100);
  const projectedVariable = currentData.variable * (1 - variableCut / 100);
  const projectedRevenue = currentData.revenue * (1 + salesIncrease / 100);
  const projectedProfit = projectedRevenue - projectedVariable - projectedFixed;

  return (
    <div className="fixed inset-0 bg-black/60 backdrop-blur-md z-50 flex items-center justify-center p-4">
      <div className="bg-white rounded-[2rem] w-full max-w-2xl shadow-2xl overflow-hidden animate-in zoom-in-95 flex flex-col">
