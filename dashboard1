        // --- LÓGICA DE IA (GEMINI) ---

        // Função Genérica de Fetch (POST)
        async function postToGemini(apiUrl, payload) {
            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!response.ok) {
                    throw new Error(`API Error: ${response.status} ${response.statusText}`);
                }
                return await response.json();
            } catch (error) {
                console.error("Erro na chamada da API Gemini:", error);
                return null;
            }
        }

        // 1. IA: Analisar Chat (JSON)
        async function analisarChat(chatId) {
            const chat = mockNovosChats.find(c => c.id === chatId);
            if (!chat) return;
            
            const button = document.querySelector(`button[onclick="analisarChat('${chatId}')"]`);
            const originalIcon = button.innerHTML;
            button.innerHTML = '<div class="spinner w-4 h-4"></div>'; // Mostra loading
            button.disabled = true;

            const systemPrompt = `Você é um assistente de triagem para uma loja de motos. 
            Analise a mensagem do cliente e retorne APENAS um objeto JSON com duas chaves: 
            1. "categoria": (escolha UMA: 'vendas', 'cliente', 'empresa', 'indefinido')
            2. "resumo": (um resumo muito curto da solicitação em 4 palavras ou menos)
            
            Regras de Categoria:
            - 'vendas': Pergunta sobre preços, compra de produtos (capacete, óleo, pneu, etc).
            - 'cliente': Pergunta sobre serviços (revisão, conserto, falha na moto).
            - 'empresa': Parece ser um CNPJ, pedido em atacado, faturamento.
            - 'indefinido': Se não for claro.
            `;
            
            const payload = {
                contents: [{ parts: [{ text: chat.msg }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
                generationConfig: {
                    responseMimeType: "application/json",
                    responseSchema: {
                        type: "OBJECT",
                        properties: {
                            "categoria": { "type": "STRING" },
                            "resumo": { "type": "STRING" }
                        }
                    }
                }
            };
            
            const result = await postToGemini(GEMINI_API_URL, payload);
            
            if (result && result.candidates?.[0]?.content?.parts?.[0]?.text) {
                try {
                    const jsonText = result.candidates[0].content.parts[0].text;
                    const data = JSON.parse(jsonText);
                    
                    const feedbackEl = document.getElementById(`chat-feedback-${chatId}`);
                    feedbackEl.innerHTML = `
                        <span class="text-xs font-medium text-yellow-400">✨ Sugestão: ${data.categoria} (${data.resumo})</span>
                    `;
                    feedbackEl.classList.remove('hidden');
                } catch (e) {
                    console.error("Erro ao parsear JSON da IA:", e);
                }
            } else {
                 const feedbackEl = document.getElementById(`chat-feedback-${chatId}`);
                 feedbackEl.innerHTML = `<span class="text-xs text-red-400">✨ Falha na análise</span>`;
                 feedbackEl.classList.remove('hidden');
            }

            button.innerHTML = originalIcon; // Restaura ícone
            button.disabled = false;
        }

        // 2. IA: Ouvir Mensagem (TTS)
        async function ouvirMensagem(chatId, buttonEl) {
            const chat = mockNovosChats.find(c => c.id === chatId);
            if (!chat) return;

            const originalIcon = buttonEl.innerHTML;
            buttonEl.innerHTML = '<div class="spinner w-4 h-4"></div>'; // Loading
            buttonEl.disabled = true;

            const payload = {
                contents: [{ parts: [{ text: `Diga casualmente: ${chat.msg}` }] }],
                generationConfig: {
                    responseModalities: ["AUDIO"],
                    speechConfig: {
                        speechProfile: "low-latency-tts",
                        voiceConfig: { prebuiltVoiceConfig: { voiceName: "Sulafat" } } // Voz casual
                    }
                },
                model: "gemini-2.5-flash-preview-tts"
            };

            const result = await postToGemini(GEMINI_TTS_API_URL, payload);
            
            if (result?.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data) {
                const part = result.candidates[0].content.parts[0];
                const audioData = part.inlineData.data;
                const mimeType = part.inlineData.mimeType; // ex: audio/L16;rate=24000
                
                try {
                    const sampleRate = parseInt(mimeType.match(/rate=(\d+)/)[1], 10);
                    const pcmData = base64ToArrayBuffer(audioData);
                    const pcm16 = new Int16Array(pcmData);
                    const wavBlob = pcmToWav(pcm16, sampleRate);
                    const audioUrl = URL.createObjectURL(wavBlob);
                    
                    const audioPlayer = document.getElementById('tts-audio-player');
                    audioPlayer.src = audioUrl;
                    audioPlayer.play();
                } catch (e) {
                    console.error("Erro ao processar áudio:", e);
                }

            } else {
                showModal("Erro de Áudio", "Não foi possível gerar o áudio da mensagem.", "error");
            }

            buttonEl.innerHTML = originalIcon; // Restaura ícone
            buttonEl.disabled = false;
        }

        // 3. IA: Nota Automática de Pedido (Texto)
        async function gerarNotaIAPedido(carrinho) {
            if (carrinho.length === 0) return null;

            const listaPecas = carrinho.map(p => p.nome).join(', ');
            const systemPrompt = `Você é um assistente de estoque de uma oficina de motos. 
            Analise a lista de peças e escreva uma "nota" muito curta (máx 10 palavras) para o estoquista.
            Agrupe itens (ex: "Óleo e filtro" em vez de "Óleo, Filtro").
            Seja direto. Ex: "Pedido de revisão básica.", "Troca de freios e pneu.", "Manutenção de rotina."
            Retorne APENAS a nota, sem formatação.`;
            
            const payload = {
                contents: [{ parts: [{ text: `Peças: ${listaPecas}` }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            const result = await postToGemini(GEMINI_API_URL, payload);

            if (result && result.candidates?.[0]?.content?.parts?.[0]?.text) {
                return result.candidates[0].content.parts[0].text.trim();
            }
            return null; // Retorna nulo se falhar
        }


