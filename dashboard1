                       <div className="text-gray-300 hover:text-blue-600 transition-colors"><MoreHorizontal size={16} /></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            );
          })}
        </div>
      </div>

      {/* Modal Detalhes da O.S. */}
