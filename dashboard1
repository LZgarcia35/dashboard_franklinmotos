                  <div>
                    <h2 className="text-2xl font-black text-gray-900">{selectedOrder.bike}</h2>
                    <div className="flex items-center gap-2 mt-1">
                      <span className="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs font-bold uppercase tracking-wider">{selectedOrder.plate}</span>
