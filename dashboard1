        message = `Olá ${order.client}, aqui é da Franklin Motos.\n\nStatus atual da sua *${order.bike}*: *${statusMap[order.status]}*.\n\nServiço: ${order.service}`;
    }
    window.open(`https://wa.me/55${order.phone}?text=${encodeURIComponent(message)}`, '_blank');
