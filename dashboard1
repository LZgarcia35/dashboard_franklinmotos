  const requiredParts = waitingPartsOrders.map(o => o.missingParts).filter(Boolean);

  const addToCart = (itemData, linkedOrder = null) => {
    const itemToAdd = itemData || newItem;
    if (!itemToAdd.item) return;
    
    // Se for ligado a uma O.S., adiciona o ID da O.S. no item
    const cartItem = { 
        ...itemToAdd, 
        id: Date.now() + Math.random(),
        linkedOrderId: linkedOrder ? linkedOrder.id : null 
    };

    setCart([...cart, cartItem]);
    if(!itemData) setNewItem({ item: '', qty: 1, value: 0, location: '' });
  };

