        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;900&display=swap');
        body{font-family:'Inter',sans-serif; padding:60px; max-width:800px; margin:0 auto; color:#111; background-color: #fff;} 
        .box{border: 2px solid #f3f4f6; padding: 40px; position:relative; border-radius: 24px; box-shadow: 0 10px 40px rgba(0,0,0,0.05);} 
        .header{text-align:center; border-bottom: 2px solid #f97316; padding-bottom: 30px; margin-bottom: 30px;} 
        .logo{font-size:32px; font-weight:900; letter-spacing:-1.5px; color: #111;} 
        .doc-title{font-size: 14px; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 2px; margin-top: 5px;}
        .info-grid {display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 40px;}
        .info-item {background: #f9fafb; padding: 15px; border-radius: 12px;}
        .label {font-size: 10px; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;}
        .value {font-size: 14px; font-weight: 600; color: #1f2937;}
        table{width:100%; border-collapse:collapse; font-size:13px; margin-bottom: 30px;} 
        th{text-align:left; border-bottom: 2px solid #e5e7eb; padding: 10px 0; color: #9ca3af; font-weight: 700; text-transform: uppercase; font-size: 11px;} 
        .total{background: #111; color: white; padding: 25px; border-radius: 16px; display:flex; justify-content:space-between; align-items:center;} 
        .total-label {font-weight: 600; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;}
        .total-val{font-size:32px; font-weight:900; color: #f97316;} 
        .sigs{display:flex; justify-content:space-between; margin-top:80px; font-size:11px; text-transform:uppercase; color: #6b7280; font-weight: 600;} 
        .line{width:45%; border-top:1px solid #d1d5db; padding-top:10px;}
        .watermark {position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-45deg); font-size: 100px; font-weight: 900; color: rgba(0,0,0,0.03); z-index: 0; pointer-events: none;}
      </style>
      </head><body>
      <div class="box">
        <div class="watermark">FRANKLIN</div>
        <div class="header"><div class="logo">FRANKLIN MOTOS</div><div class="doc-title">Recibo de Pagamento</div></div>
        
        <div class="info-grid">
          <div class="info-item"><div class="label">Colaborador</div><div class="value">${emp.name}</div><div class="label" style="margin-top: 5px;">Cargo</div><div class="value">${emp.role}</div></div>
          <div class="info-item"><div class="label">Referência</div><div class="value">${record.month}/2025</div><div class="label" style="margin-top: 5px;">Chave PIX</div><div class="value" style="font-family: monospace;">${emp.pix}</div></div>
        </div>

        <table>
          <thead><tr><th>Descrição</th><th style="text-align:right">Valor (R$)</th></tr></thead>
          <tbody>
            <tr style="border-bottom: 1px dashed #e5e7eb;"><td style="padding:12px 0;">Salário Base</td><td style="text-align:right; font-weight: 600;">${formatCurrency(emp.baseSalary)}</td></tr>
            ${rows}
          </tbody>
        </table>

        <div class="total"><div class="total-label">Líquido a Receber</div><div class="total-val">${formatCurrency(n)}</div></div>

        <div class="sigs">
          <div class="line" style="text-align:left">Franklin Motos<br>Empregador</div>
          <div class="line" style="text-align:right">${emp.name}<br>Funcionário</div>
        </div>
      </div>
      <div style="text-align:center; font-size:10px; color:#9ca3af; margin-top:30px">Documento gerado eletronicamente em ${new Date().toLocaleDateString()}. Válido como comprovante de renda.</div>
      </body></html>
    `);
    w.document.close(); w.focus(); setTimeout(()=>w.print(),500);
  };

  if (isLoading) return <div className="min-h-screen bg-gray-50 flex items-center justify-center font-sans"><div className="flex flex-col items-center gap-4"><Loader2 className="animate-spin text-orange-500" size={48} /><p className="text-gray-500 font-medium">Iniciando Sistema...</p></div></div>;
  if (!isAppUnlocked) return <AuthFlow onLoginSuccess={(u) => { setCurrentUserData(u); setIsAppUnlocked(true); }} isConnected={isConnected} />;
  
  // Navigation Handler
  if (currentSection === 'hub') return <SectorHub onSelectSector={(s) => { setCurrentSection(s === 'financial' ? 'financial' : s); if(s === 'financial') setFinancialSubTab('payments'); }} onLogout={handleLogout} currentUser={currentUserData} />;
  if (currentSection === 'stock') return <><StockDashboard purchaseRequests={purchaseRequests} addPurchaseRequest={addPurchaseRequest} /><button onClick={() => setCurrentSection('hub')} className="fixed bottom-6 right-6 bg-orange-600 text-white p-4 rounded-full shadow-2xl hover:scale-110 transition-transform z-50"><ArrowLeft /></button></>;
  if (currentSection === 'patio') return <><PatioDashboard /><button onClick={() => setCurrentSection('hub')} className="fixed bottom-6 right-6 bg-blue-600 text-white p-4 rounded-full shadow-2xl hover:scale-110 transition-transform z-50"><ArrowLeft /></button></>;

  return (
    <div className="min-h-screen bg-gray-50 text-gray-800 font-sans selection:bg-orange-100 pb-28">
      <datalist id="discount-types">{DISCOUNT_TYPES.map(t => (<option key={t} value={t} />))}</datalist>
      <datalist id="cost-help-types">{COST_HELP_TYPES.map(t => (<option key={t} value={t} />))}</datalist>

      {/* PRINT MODAL */}
      {printModalOpen && selectedRecord && (
        <div className="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
            <div className="bg-slate-900 p-6 flex justify-between items-center"><div className="flex items-center gap-3"><div className="bg-white/10 p-2 rounded-lg"><Printer className="text-white" size={24} /></div><div><h3 className="text-xl font-bold text-white">Central de Impressão</h3><p className="text-slate-400 text-xs">Fechamento: {selectedRecord.month}/2025</p></div></div><button onClick={() => setPrintModalOpen(false)} className="text-slate-400 hover:text-white"><X size={24} /></button></div>
            <div className="p-6 overflow-y-auto">
              <h4 className="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Relatórios Gerais (Apenas Pagos)</h4>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                <button onClick={printSimplified} className="flex flex-col items-center justify-center p-6 border-2 border-gray-100 rounded-xl hover:border-orange-500 hover:bg-orange-50 transition-all group"><FileText size={32} className="text-gray-400 group-hover:text-orange-500 mb-3" /><span className="font-bold text-gray-700 group-hover:text-orange-600">Geral Simplificado</span><span className="text-xs text-gray-400 mt-1">Lista básica de valores</span></button>
                <button onClick={printDetailed} className="flex flex-col items-center justify-center p-6 border-2 border-gray-100 rounded-xl hover:border-blue-500 hover:bg-blue-50 transition-all group"><List size={32} className="text-gray-400 group-hover:text-blue-500 mb-3" /><span className="font-bold text-gray-700 group-hover:text-blue-600">Geral Detalhado</span><span className="text-xs text-gray-400 mt-1">Completo com Bancos e Descontos</span></button>
              </div>
              <h4 className="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4 border-b border-gray-100 pb-2">Recibos Individuais</h4>
              <div className="space-y-2">
                {selectedRecord.data.map(emp => (
                  <div key={emp.id} className="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100">
                    <div className="flex items-center gap-3"><div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs ${emp.isPaid15||emp.isPaid01?'bg-green-100 text-green-700':'bg-gray-200 text-gray-500'}`}>{emp.name.charAt(0)}</div><div><p className="font-bold text-sm text-gray-800">{emp.name}</p><p className="text-xs text-gray-500">{emp.isPaid15||emp.isPaid01?'Pagamento Confirmado':'Pendente'}</p></div></div>
                    <button onClick={() => printIndividual(emp)} disabled={!emp.isPaid15&&!emp.isPaid01} className="px-3 py-1.5 bg-white border border-gray-200 text-gray-600 text-xs font-bold rounded-lg hover:bg-gray-900 hover:text-white transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"><Printer size={14} /> Imprimir</button>
                  </div>
                ))}
              </div>
            </div>
            <div className="p-4 bg-gray-50 border-t border-gray-100 text-center"><p className="text-xs text-gray-400">Operador Responsável: <strong>{currentUserData?.name}</strong></p></div>
          </div>
        </div>
      )}

      {/* HEADER */}
      <header className="bg-white/80 backdrop-blur-xl border-b border-white/50 sticky top-0 z-20 px-6 py-4 flex justify-between items-center shadow-sm">
        <div className="flex items-center gap-4"><button onClick={() => setCurrentSection('hub')} className="bg-gray-100 p-2 rounded-lg hover:bg-gray-200"><ArrowLeft size={20}/></button><h1 className="text-xl font-bold">Financeiro</h1></div>
        <div className="flex bg-gray-100 p-1 rounded-xl">
           <button onClick={() => setFinancialSubTab('payments')} className={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${financialSubTab === 'payments' ? 'bg-white shadow text-gray-900' : 'text-gray-500'}`}>PAGAMENTOS</button>
           <button onClick={() => setFinancialSubTab('billing')} className={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${financialSubTab === 'billing' ? 'bg-white shadow text-gray-900' : 'text-gray-500'}`}>FATURAMENTO (DRE)</button>
           <button onClick={() => setFinancialSubTab('operational')} className={`px-4 py-2 rounded-lg text-xs font-bold transition-all ${financialSubTab === 'operational' ? 'bg-white shadow text-gray-900' : 'text-gray-500'}`}>OPERACIONAL</button>
        </div>
      </header>
      
      <main className="max-w-7xl mx-auto px-6 py-8">
        {financialSubTab === 'billing' ? <BillingDashboard currentUser={currentUserData} /> : 
         financialSubTab === 'operational' ? <OperationalDashboard purchaseRequests={purchaseRequests} updateRequestStatus={updateRequestStatus} currentUser={currentUserData} /> : (
          /* ÁREA DE PAGAMENTOS RECUPERADA */
          <div className="space-y-10 animate-in fade-in duration-500">
            <div className="flex justify-between items-center">
              <h2 className="text-2xl font-bold text-gray-900 flex items-center gap-2"><Calendar className="text-orange-500" />{currentMonth}</h2>
              {/* RESTAURADO: Alternância Painel/Histórico */}
              <div className="flex gap-2 bg-gray-100 p-1 rounded-lg">
                <button onClick={() => setActiveTab('panel')} className={`px-4 py-2 rounded-md text-xs font-bold transition-all ${activeTab==='panel'?'bg-white shadow text-gray-900':'text-gray-500'}`}>PAINEL ATUAL</button>
                <button onClick={() => setActiveTab('history')} className={`px-4 py-2 rounded-md text-xs font-bold transition-all ${activeTab==='history'?'bg-white shadow text-gray-900':'text-gray-500'}`}>HISTÓRICO</button>
              </div>
            </div>
            
            {activeTab === 'panel' ? (
               <>
                 {/* Novo Seletor de Meses para o Painel Atual */}
                 <div className="flex gap-2 overflow-x-auto pb-4 no-scrollbar mb-6">
                    {MONTHS.map(month => (
                      <button 
                        key={month} 
                        onClick={() => setCurrentMonth(month)}
                        className={`
                          px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap
                          ${currentMonth === month 
                            ? 'bg-gray-900 text-white shadow-lg' 
                            : 'bg-white text-gray-500 border border-gray-100 hover:bg-gray-50'}
                        `}
                      >
                        {month}
                      </button>
                    ))}
                 </div>

                 <div className="grid grid-cols-1 md:grid-cols-4 gap-4">{[{ label: 'Total Bruto', value: summary.totalBase, color: 'text-gray-900' }, { label: 'Total Ajuda', value: summary.totalExtras, color: 'text-green-600' }, { label: 'Descontos Totais', value: summary.totalDeductions, color: 'text-red-500' }, { label: 'Líquido Total', value: summary.totalNet, color: 'text-gray-900', isBold: true }].map((stat, idx) => (<div key={idx} className="bg-white/70 backdrop-blur-lg p-5 rounded-2xl border border-white/50 shadow-sm hover:shadow-md transition-shadow"><p className="text-xs text-gray-400 uppercase font-medium tracking-wide mb-1">{stat.label}</p><h3 className={`text-2xl ${stat.isBold ? 'font-bold' : 'font-semibold'} ${stat.color}`}>{formatCurrency(stat.value)}</h3></div>))}</div>
                 <div className="flex flex-col md:flex-row justify-between items-center gap-4 bg-white/70 backdrop-blur-lg p-2 rounded-2xl border border-white/50 shadow-sm"><div className="flex gap-1 w-full md:w-auto overflow-x-auto">{[{ id: 'all', label: 'Todos', icon: Users }, { id: 'mecanico', label: 'Mecânicos', icon: Wrench }, { id: 'adm', label: 'Adm', icon: Briefcase }].map(filter => (<button key={filter.id} onClick={() => setFilterType(filter.id)} className={`px-4 py-2 rounded-xl text-sm font-medium flex items-center gap-2 transition-all whitespace-nowrap ${filterType === filter.id ? 'bg-gray-900 text-white shadow-md' : 'text-gray-500 hover:bg-gray-50'}`}><filter.icon size={14} />{filter.label}</button>))}</div><div className="relative w-full md:w-72"><Search className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4" /><input type="text" placeholder="Buscar funcionário..." className="w-full pl-10 pr-4 py-2 bg-gray-50/50 border border-transparent rounded-xl focus:bg-white focus:border-orange-500 focus:ring-1 focus:ring-orange-500 transition-all text-sm outline-none" value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} /></div></div>
                 <div className="space-y-4">{filteredEmployees.map((emp) => (<EmployeeCard key={emp.id} emp={emp} addCostHelp={addCostHelp} removeCostHelp={removeCostHelp} updateCostHelp={updateCostHelp} addDiscount={addDiscount} removeDiscount={removeDiscount} updateDiscount={updateDiscount} togglePaid={togglePaid} handleUpload={handleUpload} removeReceipt={removeReceipt} copyToClipboard={copyToClipboard} copyFeedback={copyFeedback} />))}</div>
                 <div className="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-md border-t border-gray-200 p-4 shadow-[0_-4px_20px_rgba(0,0,0,0.05)] z-30"><div className="max-w-7xl mx-auto flex justify-between items-center"><div className="hidden md:block">{saveError && <div className="flex items-center gap-2 text-red-600 bg-red-50 px-3 py-1 rounded-lg text-sm animate-pulse"><AlertCircle size={16} />{String(saveError)}</div>}{saveSuccess && <div className="flex items-center gap-2 text-green-600 bg-green-50 px-3 py-1 rounded-lg text-sm"><CheckCircle size={16} />Alterações salvas!</div>}</div><div className="flex items-center gap-4 ml-auto"><span className="text-sm text-gray-500 hidden md:inline">Confirme os dados de {currentMonth}.</span><button onClick={handleSave} disabled={isSaving} className="bg-gray-900 text-white px-6 py-3 rounded-xl font-bold shadow-lg hover:bg-orange-600 hover:shadow-orange-500/20 transition-all flex items-center gap-2 active:scale-95 disabled:opacity-70 disabled:cursor-not-allowed">{isSaving ? <Loader2 className="animate-spin" size={18} /> : <Save size={18} />}{isSaving ? 'SALVANDO...' : `SALVAR ${currentMonth.toUpperCase()}`}</button></div></div></div>
               </>
            ) : (
               /* HISTÓRICO RESTAURADO */
               <div className="space-y-6">
                  {isLoading ? <div className="text-center py-12"><Loader2 className="mx-auto text-orange-500 animate-spin mb-2" size={32} /><p className="text-gray-500">Sincronizando...</p></div> : history.filter(h => h.month === currentMonth).length === 0 ? <div className="text-center py-12 bg-white rounded-2xl border border-gray-100"><History className="mx-auto text-gray-300 mb-3" size={48} /><p className="text-gray-500">Nenhum registro para {currentMonth}.</p></div> : (
                    <div className="space-y-3">{history.filter(h => h.month === currentMonth).map((record) => {
                        const isExpanded = expandedHistoryId === record.id;
                        return (
                          <div key={record.id} className="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-md relative">
                            <div onClick={() => setExpandedHistoryId(isExpanded ? null : record.id)} className="p-5 flex justify-between items-center cursor-pointer bg-white pr-28"><div className="flex items-center gap-4"><div className={`p-2.5 rounded-lg transition-colors ${isExpanded ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-500'}`}><FileText size={20} /></div><div><p className="font-bold text-gray-900 text-sm md:text-base">Fechamento {new Date(record.date).toLocaleDateString('pt-BR')}</p><p className="text-xs text-gray-400">{record.data.length} Funcionários</p></div></div><div className="flex items-center gap-6"><div className="text-right hidden sm:block"><p className="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Total Líquido</p><p className="font-bold text-gray-900">{formatCurrency(record.summary.totalNet)}</p></div><ChevronDown size={20} className={`text-gray-400 transition-transform duration-300 ${isExpanded ? 'rotate-180' : ''}`} /></div></div>
                            <div className="absolute top-5 right-5 flex items-center gap-2 z-10"><button onClick={(e) => { e.stopPropagation(); setSelectedRecord(record); setPrintModalOpen(true); }} className="p-2 text-gray-400 hover:text-blue-500 hover:bg-blue-50 rounded-lg transition-colors"><Printer size={18} /></button><button onClick={(e) => initiateDelete(record.id, e)} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"><Trash2 size={18} /></button></div>
                            {isExpanded && (<div className="border-t border-gray-100 bg-gray-50/50 p-5"><div className="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"><div className="overflow-x-auto"><table className="w-full text-sm text-left"><thead className="bg-gray-50 text-gray-500 font-bold text-[10px] uppercase border-b border-gray-100 tracking-wider"><tr><th className="px-4 py-3">Funcionário</th><th className="px-4 py-3 text-right">Líquido Final</th><th className="px-4 py-3 text-center">Dia 15</th><th className="px-4 py-3 text-center">Dia 01</th></tr></thead><tbody className="divide-y divide-gray-100">{record.data.map((emp) => { const h = (emp.costHelps||[]).reduce((s,c)=>s+(parseFloat(c.value)||0),0); const d = emp.discounts.reduce((s,k)=>s+(parseFloat(k.value)||0),0); const n = emp.baseSalary+h-d; return (<tr key={emp.id} className="hover:bg-gray-50/80 transition-colors"><td className="px-4 py-3"><span className="font-bold text-gray-800 block text-xs md:text-sm">{emp.name}</span><span className="text-[10px] text-gray-400 uppercase tracking-wide">{emp.role}</span></td><td className="px-4 py-3 text-right font-bold text-gray-800">{formatCurrency(n)}</td><td className="px-4 py-3 text-center">{emp.isPaid15 ? <span className="inline-flex items-center gap-1 text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold border border-green-200"><Check size={10} /> Pago</span> : <span className="text-[10px] text-gray-400 font-medium">Pendente</span>}</td><td className="px-4 py-3 text-center">{emp.isPaid01 ? <span className="inline-flex items-center gap-1 text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold border border-green-200"><Check size={10} /> Pago</span> : <span className="text-[10px] text-gray-400 font-medium">Pendente</span>}</td></tr>); })}</tbody></table></div></div></div>)}
                          </div>
                        );
                      })}
                    </div>
                  )}
               </div>
            )}
          </div>
        )}
      </main>
    </div>
  );
};

export default App;
