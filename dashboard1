                listaContainer = document.getElementById('lista-pecas-os');
                carrinho = carrinhoOS;
                onClickFn = 'adicionarAoCarrinhoOS';
            }

            if (filtroLower.length < 2) {
                 listaContainer.innerHTML = '<p class="text-sm text-gray-500 text-center">Use a busca para ver as peças.</p>';
                 return;
            }

            listaContainer.innerHTML = '';
            const pecasFiltradas = mockEstoque.filter(peca => 
                peca.nome.toLowerCase().includes(filtroLower) || 
                peca.cod.toLowerCase().includes(filtroLower)
