                        <div className="mb-2">
                            {o.partsStatus === 'requested' && <span className="text-[10px] font-bold bg-orange-100 text-orange-600 px-2 py-1 rounded-full animate-pulse">Solicitado ao Estoque</span>}
                            {o.partsStatus === 'approved' && <span className="text-[10px] font-bold bg-blue-100 text-blue-600 px-2 py-1 rounded-full">Compra Aprovada</span>}
                            {o.partsStatus === 'delivered_to_patio' && <span className="text-[10px] font-bold bg-green-100 text-green-600 px-2 py-1 rounded-full border border-green-200 flex items-center gap-1"><CheckCircle size={10}/> Disponível no Pátio</span>}
