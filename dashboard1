            // Renderiza listas de peças
            renderEstoquePecas('', 'os', listaPecasOSContainer, atendenteCarrinhoOS);
            renderEstoquePecas('', 'balcao', listaPecasBalcaoContainer, atendenteCarrinhoBalcao);

            // Renderiza painéis de admin e estoque
            renderAdminSolicitacoes();
            updateNotificationBadge();
            renderEstoqueView();
            renderEntregasDoDia(); // NOVO

            // --- Inicialização Agendamentos ---
            populateMecanicosSelect();
            renderAgendamentos();
            renderHistorico();
            
            // --- Inicialização Modal Entrega ---
            populateEntregaModalSelect();

            // --- Event Listeners Agendamentos ---
            showAgendamentoFormBtn = document.getElementById('show-agendamento-form-btn');
            if (showAgendamentoFormBtn) {
                showAgendamentoFormBtn.addEventListener('click', () => toggleAgendamentoForm(true));
            }
            if (cancelAgendamentoBtn) {
                cancelAgendamentoBtn.addEventListener('click', () => toggleAgendamentoForm(false));
            }
            if (agendamentoForm) {
                agendamentoForm.addEventListener('submit', salvarAgendamento);
            }
            if (osFileInputAdmin) {
                osFileInputAdmin.addEventListener('change', (e) => {
                    handleFileSelect(e, osFileDataAdmin, osFileFeedbackAdmin);
                });
            }
            
            // --- Event Listeners Atendente O.S. ---
            setupOSFileInputListener();
            
            // --- Event Listeners Modal Entrega ---
            if (entregaForm) {
                entregaForm.addEventListener('submit', handleEntregaSubmit);
            }
        }

    </script>
</body>
</html>
