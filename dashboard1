               /* HISTÓRICO RESTAURADO */
               <div className="space-y-6">
                  {isLoading ? <div className="text-center py-12"><Loader2 className="mx-auto text-orange-500 animate-spin mb-2" size={32} /><p className="text-gray-500">Sincronizando...</p></div> : history.filter(h => h.month === currentMonth).length === 0 ? <div className="text-center py-12 bg-white rounded-2xl border border-gray-100"><History className="mx-auto text-gray-300 mb-3" size={48} /><p className="text-gray-500">Nenhum registro para {currentMonth}.</p></div> : (
                    <div className="space-y-3">{history.filter(h => h.month === currentMonth).map((record) => {
                        const isExpanded = expandedHistoryId === record.id;
                        return (
                          <div key={record.id} className="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:shadow-md relative">
                            <div onClick={() => setExpandedHistoryId(isExpanded ? null : record.id)} className="p-5 flex justify-between items-center cursor-pointer bg-white pr-28"><div className="flex items-center gap-4"><div className={`p-2.5 rounded-lg transition-colors ${isExpanded ? 'bg-blue-100 text-blue-600' : 'bg-gray-100 text-gray-500'}`}><FileText size={20} /></div><div><p className="font-bold text-gray-900 text-sm md:text-base">Fechamento {new Date(record.date).toLocaleDateString('pt-BR')}</p><p className="text-xs text-gray-400">{record.data.length} Funcionários</p></div></div><div className="flex items-center gap-6"><div className="text-right hidden sm:block"><p className="text-[10px] text-gray-400 uppercase font-bold tracking-wider">Total Líquido</p><p className="font-bold text-gray-900">{formatCurrency(record.summary.totalNet)}</p></div><ChevronDown size={20} className={`text-gray-400 transition-transform duration-300 ${isExpanded ? 'rotate-180' : ''}`} /></div></div>
                            <div className="absolute top-5 right-5 flex items-center gap-2 z-10"><button onClick={(e) => { e.stopPropagation(); setSelectedRecord(record); setPrintModalOpen(true); }} className="p-2 text-gray-400 hover:text-blue-500 hover:bg-blue-50 rounded-lg transition-colors"><Printer size={18} /></button><button onClick={(e) => initiateDelete(record.id, e)} className="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors"><Trash2 size={18} /></button></div>
                            {isExpanded && (<div className="border-t border-gray-100 bg-gray-50/50 p-5"><div className="bg-white rounded-lg border border-gray-200 overflow-hidden shadow-sm"><div className="overflow-x-auto"><table className="w-full text-sm text-left"><thead className="bg-gray-50 text-gray-500 font-bold text-[10px] uppercase border-b border-gray-100 tracking-wider"><tr><th className="px-4 py-3">Funcionário</th><th className="px-4 py-3 text-right">Líquido Final</th><th className="px-4 py-3 text-center">Dia 15</th><th className="px-4 py-3 text-center">Dia 01</th></tr></thead><tbody className="divide-y divide-gray-100">{record.data.map((emp) => { const h = (emp.costHelps||[]).reduce((s,c)=>s+(parseFloat(c.value)||0),0); const d = emp.discounts.reduce((s,k)=>s+(parseFloat(k.value)||0),0); const n = emp.baseSalary+h-d; return (<tr key={emp.id} className="hover:bg-gray-50/80 transition-colors"><td className="px-4 py-3"><span className="font-bold text-gray-800 block text-xs md:text-sm">{emp.name}</span><span className="text-[10px] text-gray-400 uppercase tracking-wide">{emp.role}</span></td><td className="px-4 py-3 text-right font-bold text-gray-800">{formatCurrency(n)}</td><td className="px-4 py-3 text-center">{emp.isPaid15 ? <span className="inline-flex items-center gap-1 text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold border border-green-200"><Check size={10} /> Pago</span> : <span className="text-[10px] text-gray-400 font-medium">Pendente</span>}</td><td className="px-4 py-3 text-center">{emp.isPaid01 ? <span className="inline-flex items-center gap-1 text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded-full font-bold border border-green-200"><Check size={10} /> Pago</span> : <span className="text-[10px] text-gray-400 font-medium">Pendente</span>}</td></tr>); })}</tbody></table></div></div></div>)}
                          </div>
                        );
                      })}
                    </div>
                  )}
               </div>
            )}
          </div>
        )}
      </main>
    </div>
  );
};

export default App;
