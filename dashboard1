        function handleChecklistChange(pedidoId, itemId) {
            const pedido = oficinaSolicitacoes.find(p => p.id === pedidoId);
            if (!pedido) return;
            pedido.checklist[itemId] = !pedido.checklist[itemId];
            const todosMarcados = Object.values(pedido.checklist).every(Boolean);
            const btn = document.querySelector(`button[onclick="confirmarSeparacao('${pedidoId}')"]`);
            if(btn) {
                if (todosMarcados) {
                    btn.disabled = false;
                    btn.classList.remove('bg-gray-700', 'text-gray-500', 'cursor-not-allowed');
                    btn.classList.add('bg-green-600', 'bg-opacity-20', 'text-green-400', 'hover:bg-green-700');
                } else {
