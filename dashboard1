  const [newOS, setNewOS] = useState({ bike: '', plate: '', client: '', phone: '', mechanic: '', service: '', km: '', fuel: 50, obs: '' });
  const [showModal, setShowModal] = useState(false);
  const [selectedOrder, setSelectedOrder] = useState(null); // Estado para o modal do cliente
  const [draggedOrder, setDraggedOrder] = useState(null);

  const handleAddOS = () => {
    if(!newOS.bike || !newOS.plate) return;
    const newOrder = {
      id: `OS-${2028 + orders.length}`,
      ...newOS,
      status: 'waiting',
      entry: new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})
    };
    setOrders([...orders, newOrder]);
    setShowModal(false);
    setNewOS({ bike: '', plate: '', client: '', mechanic: '', service: '', km: '', fuel: 50, obs: '' });
  };

  const onDragStart = (e, id) => {
    setDraggedOrder(id);
    e.dataTransfer.effectAllowed = "move";
  };

  const onDragOver = (e) => { e.preventDefault(); };

  const onDrop = (e, newStatus) => {
    e.preventDefault();
    if (draggedOrder) {
      setOrders(orders.map(o => o.id === draggedOrder ? { ...o, status: newStatus } : o));
      setDraggedOrder(null);
    }
  };

  const sendClientWhatsapp = (order) => {
    if (!order.phone) return alert('Telefone não cadastrado!');
    const statusMap = { waiting: 'Aguardando', service: 'Em Serviço', finished: 'Finalizado' };
