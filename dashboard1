                       <div className="bg-gray-50 p-2 rounded-lg"><p className="text-[9px] text-gray-400 uppercase font-bold flex items-center gap-1"><Fuel size={10}/> Comb.</p><p className="text-xs font-bold text-gray-700">{o.fuelType}</p></div>
                    </div>

                    <div className="text-sm text-gray-700 mb-4 bg-blue-50/50 p-3 rounded-xl border border-blue-100/50 leading-snug">
